# Public identifiers only. CI reads the Astro values from GitHub repository
# variables; copy this file to .env only for local development.
SANITY_STUDIO_PROJECT_ID=5536cj5d
SANITY_STUDIO_DATASET=production

# When either Astro variable is set, both are required.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# Temporary migration-only credentials. Never expose this token to the browser.
SANITY_WRITE_TOKEN=
SANITY_DRAFT_SEED_APPROVED=
SANITY_MIGRATION_APPROVED=
