  <script is:inline type="application/json" id="prototype-data" set:html={serializeForScript(site.prototypes)}></script>

  <script>
    import {
      DEFAULT_BLUEPRINT_CTA_LABEL,
      getBlueprintCta,
      getBlueprintViewerSource,
    } from '../content/blueprint-url';
    import { getValidPrototypeTabIndex } from '../content/design-lab';
    import { fitHeroHeadlineElement } from '../content/hero-headline';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const heroHeadline = document.querySelector<HTMLElement>('[data-hero-headline]');
    if (heroHeadline) {
      let heroFitFrame: number | undefined;
      const fitHeroHeadline = () => {
        if (heroFitFrame !== undefined) window.cancelAnimationFrame(heroFitFrame);
        heroFitFrame = window.requestAnimationFrame(() => fitHeroHeadlineElement(heroHeadline));
      };
      window.addEventListener('resize', fitHeroHeadline, {passive: true});
      document.fonts.ready.then(fitHeroHeadline);
      fitHeroHeadline();
    }
    type PrototypeItem = {
      slug: string;
      title: string;
      tag: {label: string; color: 'yellow' | 'mint' | 'coral' | 'lavender'};
      tabs: Array<{
        key: string;
        label: string;
        content?: Array<
          | {key: string; type: 'paragraph'; spans: Array<{text: string; highlighted: boolean}>}
          | {key: string; type: 'list'; items: Array<{key: string; spans: Array<{text: string; highlighted: boolean}>}>}
        >;
        body?: string;
        items?: string[];
      }>;
      media: { src: string; alt: string; fit?: 'cover' | 'contain' };
      blueprintUrl?: string;
      blueprintCtaEnabled?: boolean;
      blueprintCtaLabel?: string;
    };
    type CarouselController = { start: () => void; stop: () => void };
    type IdleCarouselController = CarouselController & { reset: () => void };
    type SwipeAxis = 'pending' | 'horizontal' | 'vertical';

    const stopYouTubePlayback = (slide: HTMLElement) => {
      slide.querySelector('iframe')?.remove();
      slide.classList.remove('is-playing');
    };

    const getNativeVideo = (slide: HTMLElement) =>
      slide.matches('[data-native-video-slide]')
        ? slide.querySelector<HTMLVideoElement>('video')
        : slide instanceof HTMLVideoElement
          ? slide
          : null;

    const resetNativeVideo = (slide: HTMLElement) => {
      const video = getNativeVideo(slide);
      if (!video) return;
      const needsPosterReset = slide.classList.contains('is-playing')
        || !video.paused
        || video.currentTime > 0;
      video.pause();
      slide.classList.remove('is-playing');
      video.controls = false;
      if (needsPosterReset) {
        try { video.currentTime = 0; } catch { /* Media metadata may not be available yet. */ }
        video.load();
      }
    };

    const playNativeVideo = (slide: HTMLElement) => {
      const video = getNativeVideo(slide);
      if (!video || slide.classList.contains('is-playing')) return;
      slide.classList.add('is-playing');
      video.controls = true;
      video.addEventListener('ended', () => {
        resetNativeVideo(slide);
        slide.dispatchEvent(new CustomEvent('carouselvideoend', {bubbles: true}));
      }, {once: true});
      video.play().catch(() => {
        slide.classList.remove('is-playing');
        video.controls = false;
      });
      slide.dispatchEvent(new CustomEvent('carouselvideoplay', {bubbles: true}));
    };

    const resetVideoSlide = (slide: HTMLElement) => {
      if (slide.dataset.youtubeVideoId) stopYouTubePlayback(slide);
      resetNativeVideo(slide);
    };

    const playYouTubeVideo = (slide: HTMLElement) => {
      const videoId = slide.dataset.youtubeVideoId;
      if (!videoId || slide.classList.contains('is-playing')) return;

      const iframe = document.createElement('iframe');
      iframe.className = 'carousel-youtube-player';
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&playsinline=1&rel=0&modestbranding=1`;
      iframe.title = slide.dataset.youtubeTitle || 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      slide.classList.add('is-playing');
      slide.append(iframe);
      slide.dispatchEvent(new CustomEvent('carouselvideoplay', {bubbles: true}));
      iframe.focus({preventScroll: true});
    };

    document.addEventListener('click', (event) => {
      const playButton = (event.target as HTMLElement).closest<HTMLButtonElement>('.carousel-play');
      if (!playButton) return;
      const slide = playButton.closest<HTMLElement>('[data-youtube-video-id], [data-native-video-slide]');
      if (!slide) return;
      event.stopPropagation();
      if (slide.dataset.youtubeVideoId) playYouTubeVideo(slide);
      else playNativeVideo(slide);
    });

    const resetAllCarouselVideos = () => {
      document.querySelectorAll<HTMLElement>('[data-youtube-video-id], [data-native-video-slide]')
        .forEach(resetVideoSlide);
    };

    const createIdleAutoplayController = ({
      enabled,
      itemCount,
      intervalMilliseconds,
      getActiveVideo,
      advance,
      syncPlayback,
    }: {
      enabled: boolean;
      itemCount: number;
      intervalMilliseconds: number;
      getActiveVideo: () => HTMLVideoElement | null;
      advance: () => void;
      syncPlayback: () => void;
    }): IdleCarouselController => {
      let running = false;
      let timer: number | undefined;
      let waitingVideo: HTMLVideoElement | null = null;

      const handleVideoEnded = () => {
        waitingVideo = null;
        if (!running) return;
        advance();
        schedule();
      };

      const clearPendingAdvance = () => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = undefined;
        waitingVideo?.removeEventListener('ended', handleVideoEnded);
        waitingVideo = null;
      };

      const schedule = () => {
        clearPendingAdvance();
        if (
          !running
          || !enabled
          || itemCount <= 1
          || !Number.isFinite(intervalMilliseconds)
          || intervalMilliseconds <= 0
          || reducedMotion.matches
          || document.hidden
        ) return;

        timer = window.setTimeout(() => {
          timer = undefined;
          if (!running) return;
          const activeVideo = getActiveVideo();
          if (activeVideo && !activeVideo.paused && !activeVideo.ended) {
            waitingVideo = activeVideo;
            activeVideo.addEventListener('ended', handleVideoEnded, {once: true});
            return;
          }
          advance();
          schedule();
        }, intervalMilliseconds);
      };

      const start = () => {
        running = true;
        syncPlayback();
        schedule();
      };
      const stop = () => {
        running = false;
        clearPendingAdvance();
      };
      const reset = () => {
        if (running) schedule();
        else start();
      };

      return {start, stop, reset};
    };

    const bindIdleActivity = (root: HTMLElement, autoplay: IdleCarouselController) => {
      let lastPointerActivity = 0;
      let pointerHeld = false;
      root.addEventListener('pointerdown', () => {
        pointerHeld = true;
        autoplay.stop();
      }, {passive: true});
      const releasePointer = () => {
        pointerHeld = false;
        autoplay.start();
      };
      root.addEventListener('pointerup', releasePointer, {passive: true});
      root.addEventListener('pointercancel', releasePointer, {passive: true});
      root.addEventListener('pointermove', (event) => {
        if (pointerHeld || event.pointerType === 'touch') return;
        const now = performance.now();
        if (now - lastPointerActivity < 240) return;
        lastPointerActivity = now;
        autoplay.reset();
      }, {passive: true});
      root.addEventListener('focusin', autoplay.reset);
    };

    const setupHorizontalSwipe = (
      surface: HTMLElement | null,
      onSwipe: (direction: -1 | 1) => void,
      options: {minimumDistance?: number} = {},
    ) => {
      if (!surface) return;

      const minimumDistance = options.minimumDistance ?? 45;
      let touchStartX = 0;
      let touchStartY = 0;
      let touchAxis: SwipeAxis = 'pending';
      let pointerStartX = 0;
      let pointerStartY = 0;
      let pointerActive = false;
      let wheelDistance = 0;
      let wheelLocked = false;

      const resetTouch = () => {
        touchStartX = 0;
        touchStartY = 0;
        touchAxis = 'pending';
      };

      surface.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
        touchStartY = event.changedTouches[0]?.clientY ?? 0;
        touchAxis = 'pending';
      }, {passive: true});

      surface.addEventListener('touchmove', (event) => {
        const touch = event.touches[0];
        if (!touch) return;
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;
        const distanceX = Math.abs(deltaX);
        const distanceY = Math.abs(deltaY);

        if (touchAxis === 'pending' && Math.max(distanceX, distanceY) >= 8) {
          if (distanceX >= distanceY * 0.78) touchAxis = 'horizontal';
          else if (distanceY >= 16 && distanceY > distanceX * 1.35) touchAxis = 'vertical';
        }

        if (touchAxis === 'horizontal' && event.cancelable) event.preventDefault();
      }, {passive: false});

      surface.addEventListener('touchend', (event) => {
        const deltaX = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
        const deltaY = (event.changedTouches[0]?.clientY ?? touchStartY) - touchStartY;
        const horizontalIntent = touchAxis === 'horizontal'
          || (touchAxis === 'pending' && Math.abs(deltaX) >= Math.abs(deltaY) * 0.78);

        if (horizontalIntent && Math.abs(deltaX) > minimumDistance) onSwipe(deltaX < 0 ? 1 : -1);
        resetTouch();
      }, {passive: true});

      surface.addEventListener('touchcancel', resetTouch, {passive: true});

      surface.addEventListener('pointerdown', (event) => {
        const interactiveTarget = event.target instanceof Element
