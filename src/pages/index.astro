      const identity = safeDomToken(prototype.slug || String(prototypeIndex));
      const tabs = prototype.tabs.map((tab, index) => {
        const button = document.createElement('button');
        button.id = `lab-${identity}-tab-${safeDomToken(tab.key)}`;
