          duration: 240,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'both',
        });
        const runningAnimations = [enterAnimation];

        if (compactLayout && prototypePanelsRoot) {
          const panelStyles = window.getComputedStyle(prototypePanelsRoot);
          const verticalPadding = Number.parseFloat(panelStyles.paddingTop)
            + Number.parseFloat(panelStyles.paddingBottom);
          const endHeight = nextPanel.getBoundingClientRect().height + verticalPadding;
          if (Math.abs(endHeight - startHeight) > 1) {
            runningAnimations.push(prototypePanelsRoot.animate([
              {height: `${startHeight}px`},
              {height: `${endHeight}px`},
            ], {
              duration: 260,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'both',
            }));
          }
        }

        prototypePanelTransitionAnimations = runningAnimations;
        Promise.allSettled(runningAnimations.map((animation) => animation.finished)).then(() => {
          if (transitionId !== prototypePanelTransitionId) return;
          stopPrototypePanelTransition();
        });
      }).catch(() => {
        if (transitionId === prototypePanelTransitionId) stopPrototypePanelTransition();
      });
    };

    prototypeTabList?.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-lab-tab-index]');
      if (tab) {
        showPrototypeInfo(Number(tab.dataset.labTabIndex));
        prototypeAutoplay?.reset();
      }
    });
    prototypeTabList?.addEventListener('keydown', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-lab-tab-index]');
      if (!tab || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const tabs = getPrototypeInfoTabs();
      const index = Number(tab.dataset.labTabIndex);
      const lastIndex = tabs.length - 1;
      const nextIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? lastIndex
          : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      showPrototypeInfo(nextIndex, true);
      prototypeAutoplay?.reset();
    });

    const stopPrototypeContentAnimations = () => {
      prototypeContentAnimations.forEach((animation) => animation.cancel());
      prototypeContentAnimations = [];
    };

    const syncPrototypeMediaPlayback = () => {
      prototypeMedia.forEach((media, index) => {
        if (index !== prototypeIndex) resetNativeVideo(media);
      });
    };

    const showPrototype = (nextIndex: number, animateContent = true) => {
      if (blueprintModal?.open) return;
      const previousIndex = prototypeIndex;
      const targetIndex = (nextIndex + prototypeData.length) % prototypeData.length;
      const item = prototypeData[targetIndex];
      if (!item) return;
      if (targetIndex === previousIndex && animateContent) return;

      const direction = nextIndex >= previousIndex ? 1 : -1;
      prototypeIndex = targetIndex;
      prototypeMedia.forEach((media, index) => {
        const active = index === prototypeIndex;
        const decorative = media.dataset.decorative === 'true';
        media.classList.toggle('is-active', active);
        media.setAttribute('aria-hidden', String(decorative || !active));
        media.querySelector<HTMLButtonElement>('.carousel-play')?.setAttribute('tabindex', active ? '0' : '-1');
        if (!active) resetVideoSlide(media);
      });
      syncPrototypeMediaPlayback();
      if (prototypePosition) prototypePosition.textContent = `${String(prototypeIndex + 1).padStart(2, '0')} / ${String(prototypeData.length).padStart(2, '0')}`;
      prototypeDots.forEach((dot, index) => {
        const active = index === prototypeIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-pressed', String(active));
      });
      keepActivePrototypeControlVisible();

      const updateContent = () => {
        if (prototypeTag) {
          prototypeTag.textContent = item.tag.label;
          prototypeTag.dataset.tagColor = item.tag.color;
        }
        if (prototypeTitle) prototypeTitle.textContent = item.title;
        renderPrototypeTabs(item);
        if (prototypeBlueprint) {
          const blueprintCta = getBlueprintCta(item);
          const blueprintCtaHidden = item.blueprintCtaEnabled === false;
          prototypeBlueprint.hidden = blueprintCtaHidden;
          prototypeBlueprint.disabled = !blueprintCta;
          if (blueprintCta) {
            prototypeBlueprint.textContent = blueprintCta.label;
            prototypeBlueprint.setAttribute('aria-label', `View ${item.title} blueprint`);
          } else {
            prototypeBlueprint.textContent = item.blueprintCtaLabel?.trim()
              || DEFAULT_BLUEPRINT_CTA_LABEL;
            prototypeBlueprint.setAttribute('aria-label', `Blueprint unavailable for ${item.title}`);
          }
        }
      };

      stopPrototypeContentAnimations();
      const transitionId = ++prototypeContentTransitionId;
      const activeFolderCopy = getPrototypeInfoPanels()
        .find((panel) => !panel.hidden)
        ?.querySelector<HTMLElement>('[data-lab-tab-body], [data-lab-tab-items]');
      const exitTargets = [prototypeTag, prototypeTitle, activeFolderCopy]
        .filter((target): target is HTMLElement => Boolean(target));

      if (!animateContent || reducedMotion.matches || !exitTargets.length) {
        updateContent();
        prototypeModule?.classList.remove('is-prototype-transitioning');
        prototypeModule?.removeAttribute('aria-busy');
        return;
      }

      prototypeModule?.classList.add('is-prototype-transitioning');
      prototypeModule?.setAttribute('aria-busy', 'true');
      const exitAnimations = exitTargets.map((target) => target.animate([
        {opacity: 1, transform: 'translateX(0)', filter: 'blur(0)'},
        {opacity: 0.18, transform: `translateX(${direction * -7}px)`, filter: 'blur(1.5px)'},
      ], {
        duration: 115,
        easing: 'cubic-bezier(0.4, 0, 1, 1)',
        fill: 'forwards',
      }));
      prototypeContentAnimations = exitAnimations;

      Promise.allSettled(exitAnimations.map((animation) => animation.finished)).then(() => {
        if (transitionId !== prototypeContentTransitionId) return;
        updateContent();
        exitAnimations.forEach((animation) => animation.cancel());

        const activeFolderCopy = getPrototypeInfoPanels()
          .find((panel) => !panel.hidden)
          ?.querySelector<HTMLElement>('[data-lab-tab-body], [data-lab-tab-items]');
        const enterTargets = [prototypeTag, prototypeTitle, activeFolderCopy]
          .filter((target): target is HTMLElement => Boolean(target));
        const enterAnimations = enterTargets.map((target, index) => target.animate([
          {opacity: 0.24, transform: `translateX(${direction * 8}px)`, filter: 'blur(1.5px)'},
          {opacity: 1, transform: 'translateX(0)', filter: 'blur(0)'},
        ], {
          duration: 250,
          delay: index * 24,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'both',
        }));
        prototypeContentAnimations = enterAnimations;

        Promise.allSettled(enterAnimations.map((animation) => animation.finished)).then(() => {
          if (transitionId !== prototypeContentTransitionId) return;
          enterAnimations.forEach((animation) => animation.cancel());
          prototypeContentAnimations = [];
          prototypeModule?.classList.remove('is-prototype-transitioning');
          prototypeModule?.removeAttribute('aria-busy');
        });
      });
    };
    prototypeAutoplay = createIdleAutoplayController({
      enabled: prototypeAutoSwitchEnabled,
      itemCount: prototypeData.length,
      intervalMilliseconds: prototypeSwitchIntervalMilliseconds,
      getActiveVideo: () => getNativeVideo(prototypeMedia[prototypeIndex]),
      advance: () => showPrototype(prototypeIndex + 1),
      syncPlayback: syncPrototypeMediaPlayback,
    });
    prototypeModule?.addEventListener('carouselvideoplay', () => prototypeAutoplay?.stop());
    prototypeModule?.addEventListener('carouselvideoend', () => prototypeAutoplay?.start());
    const selectPrototype = (nextIndex: number) => {
      showPrototype(nextIndex);
      prototypeAutoplay?.reset();
    };
    prototypeModule?.querySelectorAll('[data-prototype-prev]').forEach((control) => {
      control.addEventListener('click', () => selectPrototype(prototypeIndex - 1));
    });
    prototypeModule?.querySelectorAll('[data-prototype-next]').forEach((control) => {
      control.addEventListener('click', () => selectPrototype(prototypeIndex + 1));
    });
    prototypeDots.forEach((dot, index) => dot.addEventListener('click', () => selectPrototype(index)));
    if (prototypeData.length > 1) {
      setupHorizontalSwipe(prototypeMediaStage ?? null, (direction) => {
        if (!blueprintModal?.open) selectPrototype(prototypeIndex + direction);
      }, {minimumDistance: 36});
      prototypeMediaStage?.addEventListener('keydown', (event) => {
        if (blueprintModal?.open || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
        event.preventDefault();
        selectPrototype(prototypeIndex + (event.key === 'ArrowRight' ? 1 : -1));
      });
      if (prototypeModule && prototypeAutoplay) bindIdleActivity(prototypeModule, prototypeAutoplay);
    }

    const openBlueprintViewer = (event: MouseEvent) => {
      const source = getBlueprintViewerSource(prototypeData[prototypeIndex]);
      if (!source || !blueprintModal || !blueprintIframe) return;

      blueprintReturnFocus = prototypeBlueprint ?? null;
      if (blueprintDialogTitle) blueprintDialogTitle.textContent = source.title;
      setBlueprintLoading(true);
      blueprintIframe.title = source.iframeTitle;
      document.documentElement.classList.add('blueprint-dialog-open');
      blueprintModal.showModal();
      setBlueprintBackgroundInert(true);
      syncCarouselAutoplay();
      blueprintLoadFrame = window.requestAnimationFrame(() => {
        blueprintLoadFrame = undefined;
        if (!blueprintModal.open) return;
        blueprintViewer?.getBoundingClientRect();
        blueprintIframe.src = source.src;
      });
      const pointerActivated = event.detail !== 0;
      blueprintClose?.classList.toggle('suppress-initial-focus', pointerActivated);
      blueprintClose?.focus({preventScroll: true});
      if (pointerActivated) {
        document.addEventListener('keydown', () => {
          blueprintClose?.classList.remove('suppress-initial-focus');
        }, {capture: true, once: true});
      }
    };

    prototypeBlueprint?.addEventListener('click', openBlueprintViewer);
    blueprintIframe?.addEventListener('load', () => setBlueprintLoading(false));
    blueprintClose?.addEventListener('click', () => blueprintModal?.close());
    blueprintModal?.addEventListener('close', () => {
      document.documentElement.classList.remove('blueprint-dialog-open');
      setBlueprintBackgroundInert(false);
      if (blueprintLoadFrame) window.cancelAnimationFrame(blueprintLoadFrame);
      blueprintLoadFrame = undefined;
      blueprintIframe?.removeAttribute('src');
      setBlueprintLoading(false);
      blueprintClose?.classList.remove('suppress-initial-focus');
      blueprintReturnFocus?.focus({preventScroll: true});
      blueprintReturnFocus = null;
      syncCarouselAutoplay();
    });

    showPrototype(0, false);
    if (prototypeAutoplay) mediaCarousels.push(prototypeAutoplay);
    syncCarouselAutoplay();

    const projectModal = document.querySelector<HTMLDialogElement>('[data-project-modal]');
    const projectPanels = Array.from(projectModal?.querySelectorAll<HTMLElement>('[data-project-detail]') ?? []);
    const shippedProjectPanels = Array.from(
      projectModal?.querySelectorAll<HTMLElement>('[data-project-detail][data-project-index]') ?? [],
    );
    const projectCarouselControllers = new Map<HTMLElement, {reset: () => void}>();
    const touchFirstInput = window.matchMedia('(hover: none), (pointer: coarse)');
    const projectMotionReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let projectReturnFocus: HTMLElement | null = null;
    let projectDialogOpenedWithPointer = false;
    let projectSwitching = false;

    projectPanels.forEach((panel) => {
      const gallery = panel.querySelector<HTMLElement>('[data-project-detail-gallery]');
      const slides = Array.from(gallery?.querySelectorAll<HTMLElement>('[data-project-detail-slide]') ?? []);
      const dots = Array.from(gallery?.querySelectorAll<HTMLButtonElement>('[data-project-detail-dot]') ?? []);
      const position = gallery?.querySelector<HTMLElement>('[data-project-detail-position]');
      if (!gallery || slides.length < 1) return;
      let mediaIndex = 0;

      const prepareMedia = (index: number) => {
        const slide = slides[(index + slides.length) % slides.length];
        if (slide instanceof HTMLImageElement) {
          slide.loading = 'eager';
          slide.decode().catch(() => undefined);
        } else {
          const video = getNativeVideo(slide);
          if (video?.preload === 'none') video.preload = 'metadata';
        }
      };

      const showMedia = (nextIndex: number, prepareAdjacent = true) => {
        mediaIndex = (nextIndex + slides.length) % slides.length;
        if (prepareAdjacent) {
          prepareMedia(mediaIndex);
          prepareMedia(mediaIndex - 1);
          prepareMedia(mediaIndex + 1);
        }
        slides.forEach((slide, index) => {
          const active = index === mediaIndex;
          const decorative = slide.dataset.decorative === 'true';
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', String(decorative || !active));
          slide.querySelector<HTMLButtonElement>('.carousel-play')?.setAttribute('tabindex', active ? '0' : '-1');
          if (!active) resetVideoSlide(slide);
        });
        dots.forEach((dot, index) => {
          const active = index === mediaIndex;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-pressed', String(active));
        });
        if (position) position.textContent = `${String(mediaIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      };

      if (slides.length > 1) {
        gallery.querySelector('[data-detail-media-prev]')?.addEventListener('click', () => showMedia(mediaIndex - 1));
        gallery.querySelector('[data-detail-media-next]')?.addEventListener('click', () => showMedia(mediaIndex + 1));
        dots.forEach((dot, index) => dot.addEventListener('click', () => showMedia(index)));
        gallery.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          showMedia(mediaIndex + (event.key === 'ArrowRight' ? 1 : -1));
        });
        setupHorizontalSwipe(gallery.querySelector<HTMLElement>('.project-detail-stage'), (direction) => {
          showMedia(mediaIndex + direction);
        }, {minimumDistance: 40});
      }

      projectCarouselControllers.set(panel, {reset: () => showMedia(0, true)});
      showMedia(0, false);
    });

    const showProjectDetail = async (
      slug: string,
      returnFocus?: HTMLElement | null,
      direction = 0,
    ) => {
      if (!projectModal) return;
      const panel = projectPanels.find((candidate) => candidate.dataset.projectDetail === slug);
      if (!panel) return;
      const wasOpen = projectModal.open;
      const currentPanel = projectPanels.find((candidate) => !candidate.hidden);
      const shouldAnimate = Boolean(
        wasOpen
        && currentPanel
        && currentPanel !== panel
        && direction !== 0
        && !projectMotionReduced.matches,
      );
      if (projectSwitching && wasOpen) return;
      if (returnFocus) projectReturnFocus = returnFocus;

      const dialogShell = projectModal.querySelector<HTMLElement>('.project-dialog-shell');
      if (shouldAnimate && currentPanel) {
        projectSwitching = true;
        projectModal.classList.add('is-switching-project');
        dialogShell?.setAttribute('aria-busy', 'true');
        const outgoing = currentPanel.animate(
          [
            {opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)'},
            {opacity: 0, transform: `translate3d(${-direction * 14}px, 0, 0) scale(0.996)`},
          ],
          {duration: 120, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards'},
        );
        await outgoing.finished.catch(() => undefined);
        outgoing.cancel();
      }

      projectPanels.forEach((candidate) => {
        const active = candidate === panel;
        candidate.hidden = !active;
        if (!active) {
          candidate.querySelectorAll<HTMLElement>('[data-youtube-video-id], [data-native-video-slide]').forEach(resetVideoSlide);
        }
      });
      projectCarouselControllers.get(panel)?.reset();
      const title = panel.querySelector('h2');
      if (title?.id) projectModal.setAttribute('aria-labelledby', title.id);
      dialogShell?.scrollTo({top: 0, behavior: 'auto'});
      if (!wasOpen) {
        document.documentElement.classList.add('project-dialog-open');
        projectModal.showModal();
        syncCarouselAutoplay();
      }

      if (shouldAnimate) {
        const incoming = panel.animate(
          [
            {opacity: 0, transform: `translate3d(${direction * 22}px, 0, 0) scale(0.996)`},
            {opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)'},
          ],
          {duration: 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both'},
        );
        await incoming.finished.catch(() => undefined);
        incoming.cancel();
        projectSwitching = false;
        projectModal.classList.remove('is-switching-project');
        dialogShell?.removeAttribute('aria-busy');
      }

      if (wasOpen) title?.focus({preventScroll: true});
      else {
        const closeButton = projectModal.querySelector<HTMLButtonElement>('[data-dialog-close]');
        closeButton?.classList.toggle('suppress-initial-focus', projectDialogOpenedWithPointer);
        closeButton?.focus({preventScroll: true});
      }
    };

    document.querySelectorAll<HTMLElement>('[data-project-dialog]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        projectDialogOpenedWithPointer = touchFirstInput.matches && event.detail !== 0;
        const slug = trigger.getAttribute('data-project-dialog');
        if (slug) void showProjectDetail(slug, trigger);
      });
    });

    projectModal?.addEventListener('keydown', () => {
      projectDialogOpenedWithPointer = false;
      projectModal.querySelector('[data-dialog-close]')?.classList.remove('suppress-initial-focus');
    }, {capture: true});

    shippedProjectPanels.forEach((panel, index) => {
      panel.querySelector('[data-detail-project-prev]')?.addEventListener('click', () => {
        const previous = shippedProjectPanels[(index - 1 + shippedProjectPanels.length) % shippedProjectPanels.length];
        if (previous?.dataset.projectDetail) void showProjectDetail(previous.dataset.projectDetail, undefined, -1);
      });
      panel.querySelector('[data-detail-project-next]')?.addEventListener('click', () => {
        const next = shippedProjectPanels[(index + 1) % shippedProjectPanels.length];
        if (next?.dataset.projectDetail) void showProjectDetail(next.dataset.projectDetail, undefined, 1);
      });
    });

    projectModal?.querySelector('[data-dialog-close]')?.addEventListener('click', () => projectModal.close());
    projectModal?.addEventListener('click', (event) => { if (event.target === projectModal) projectModal.close(); });
    projectModal?.addEventListener('close', () => {
      projectSwitching = false;
      projectModal.classList.remove('is-switching-project');
      projectModal.querySelector<HTMLElement>('.project-dialog-shell')?.removeAttribute('aria-busy');
      document.documentElement.classList.remove('project-dialog-open');
      projectPanels.forEach((panel) => {
        panel.querySelectorAll<HTMLElement>('[data-youtube-video-id], [data-native-video-slide]').forEach(resetVideoSlide);
      });
      projectModal.querySelector('[data-dialog-close]')?.classList.remove('suppress-initial-focus');
      const returnFocusTarget = projectReturnFocus;
      if (projectDialogOpenedWithPointer) {
        returnFocusTarget?.classList.add('suppress-return-focus');
        returnFocusTarget?.addEventListener('blur', () => {
          returnFocusTarget.classList.remove('suppress-return-focus');
        }, {once: true});
      }
      returnFocusTarget?.focus({preventScroll: true});
      projectReturnFocus = null;
      projectDialogOpenedWithPointer = false;
      syncCarouselAutoplay();
    });

    const sectionNavigationLinks = document.querySelectorAll<HTMLAnchorElement>(
      '.brand[href^="#"], .desktop-nav a[href^="#"], .mobile-menu nav a[href^="#"], .site-footer a[href^="#"]',
    );
    sectionNavigationLinks.forEach((link) => link.addEventListener('click', (event) => {
      const hash = link.getAttribute('href');
      if (!hash || hash === '#resume') return;

      const target = document.querySelector<HTMLElement>(hash);
      if (!target) return;

      event.preventDefault();
      target.scrollIntoView({
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
        block: 'start',
      });
      history.replaceState(history.state, '', `${location.pathname}${location.search}`);
      link.closest('details')?.removeAttribute('open');
    }));
  </script>
</BaseLayout>
