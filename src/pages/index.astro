    let prototypeIndex = 0;
    let activePrototypeTabIndex = 0;
    const prototypeTag = prototypeModule?.querySelector<HTMLElement>('[data-prototype-tag]');
    const prototypeTitle = prototypeModule?.querySelector<HTMLElement>('[data-prototype-title]');
    const prototypeTabList = prototypeModule?.querySelector<HTMLElement>('[data-lab-tab-list]');
    const prototypePanelsRoot = prototypeModule?.querySelector<HTMLElement>('[data-lab-panels]');
    const prototypeMedia = Array.from(prototypeModule?.querySelectorAll<HTMLElement>('[data-prototype-media]') ?? []);
    const prototypeBlueprint = prototypeModule?.querySelector<HTMLButtonElement>('[data-prototype-blueprint]');
    const prototypePosition = prototypeModule?.querySelector('[data-prototype-position]');
    const prototypeDots = Array.from(prototypeModule?.querySelectorAll<HTMLButtonElement>('[data-prototype-dot]') ?? []);
    const prototypeMediaStage = prototypeModule?.querySelector<HTMLElement>('.lab-media');
    const prototypeAutoSwitchEnabled = prototypeModule?.dataset.autoSwitch === 'true';
    const prototypeSwitchIntervalMilliseconds = Number(prototypeModule?.dataset.switchSeconds) * 1000;
    let prototypeAutoplay: IdleCarouselController | undefined;
    let prototypePanelTransitionAnimations: Animation[] = [];
    let prototypePanelTransitionId = 0;
    let prototypeContentTransitionId = 0;
    let prototypeContentAnimations: Animation[] = [];

    const keepActivePrototypeControlVisible = () => {
      const activeDot = prototypeDots[prototypeIndex];
      const progress = activeDot?.parentElement;
      if (!activeDot || !progress || progress.scrollWidth <= progress.clientWidth) return;
      const left = activeDot.offsetLeft - (progress.clientWidth - activeDot.offsetWidth) / 2;
      progress.scrollTo({
        left: Math.max(0, left),
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    };
    const blueprintModal = document.querySelector<HTMLDialogElement>('[data-blueprint-modal]');
    const blueprintDialogTitle = blueprintModal?.querySelector('[data-blueprint-dialog-title]');
    const blueprintViewer = blueprintModal?.querySelector<HTMLElement>('[data-blueprint-viewer]');
    const blueprintLoading = blueprintModal?.querySelector<HTMLElement>('[data-blueprint-loading]');
    const blueprintIframe = blueprintModal?.querySelector<HTMLIFrameElement>('[data-blueprint-iframe]');
    const blueprintClose = blueprintModal?.querySelector<HTMLButtonElement>('[data-blueprint-dialog-close]');
    const siteFrame = document.querySelector<HTMLElement>('.site-frame');
    let blueprintReturnFocus: HTMLElement | null = null;
    let blueprintLoadFrame: number | undefined;

    const setBlueprintBackgroundInert = (isInert: boolean) => {
