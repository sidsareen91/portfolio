      };

      const animateTo = (targetLeft: number) => {
        stopScrollAnimation();
        const startLeft = track.scrollLeft;
        const distance = targetLeft - startLeft;
        if (reducedMotion.matches || Math.abs(distance) < 1) {
          track.scrollTo({left: targetLeft, behavior: 'auto'});
          return;
        }

        const cardWidth = Math.max(cards[0]?.getBoundingClientRect().width ?? 1, 1);
        const duration = Math.min(620, 430 + (Math.abs(distance) / cardWidth) * 90);
        const startedAt = performance.now();
        track.classList.add('is-animating');

        const step = (now: number) => {
          const progress = Math.min((now - startedAt) / duration, 1);
          const easedProgress = 1 - Math.pow(1 - progress, 4);
          track.scrollTo({left: startLeft + distance * easedProgress, behavior: 'auto'});
          if (progress < 1) {
            scrollAnimationFrame = window.requestAnimationFrame(step);
            return;
          }

          scrollAnimationFrame = undefined;
          track.scrollTo({left: targetLeft, behavior: 'auto'});
          track.classList.remove('is-animating');
        };

        scrollAnimationFrame = window.requestAnimationFrame(step);
      };

      const show = (nextIndex: number, animate = true) => {
        syncControls(nextIndex);
        if (!desktopViewport.matches) return;
        const targetLeft = cardOffset(currentIndex);
        if (!animate) {
          stopScrollAnimation();
          track.scrollTo({left: targetLeft, behavior: 'auto'});
          return;
        }
        animateTo(targetLeft);
      };

      previousButton?.addEventListener('click', () => show(currentIndex - 1));
      nextButton?.addEventListener('click', () => show(currentIndex + 1));

      root.addEventListener('keydown', (event) => {
        if (!desktopViewport.matches || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
        event.preventDefault();
        show(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
      });

      const syncFromScrollPosition = () => {
        const closestIndex = cardOffsets.reduce((closest, offset, index) => (
          Math.abs(track.scrollLeft - offset) < Math.abs(track.scrollLeft - cardOffsets[closest])
            ? index
            : closest
        ), 0);
        syncControls(Math.min(closestIndex, maximumIndex));
      };

      track.addEventListener('scroll', () => {
        if (!desktopViewport.matches || scrollAnimationFrame !== undefined) return;
        if (scrollIdleTimer !== undefined) window.clearTimeout(scrollIdleTimer);
        scrollIdleTimer = window.setTimeout(() => {
          scrollIdleTimer = undefined;
          syncFromScrollPosition();
        }, 90);
      }, {passive: true});

      track.addEventListener('pointerdown', stopScrollAnimation, {passive: true});
      track.addEventListener('wheel', stopScrollAnimation, {passive: true});

      desktopViewport.addEventListener('change', () => {
        if (!desktopViewport.matches) return;
        refreshCardOffsets();
        show(currentIndex, false);
      });
      window.addEventListener('resize', () => {
        if (!desktopViewport.matches || resizeFrame !== undefined) return;
        resizeFrame = window.requestAnimationFrame(() => {
          resizeFrame = undefined;
          refreshCardOffsets();
          show(currentIndex, false);
        });
      }, {passive: true});

      refreshCardOffsets();
      syncControls(0);
    };

    setupShippedWorkCarousel();

    const syncCarouselAutoplay = () => {
