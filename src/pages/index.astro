    const setupMediaCarousel = (
      root: HTMLElement | null,
      slideSelector: string,
      dotSelector: string,
    ): CarouselController | null => {
      if (!root) return null;
      const slides = Array.from(root.querySelectorAll<HTMLElement>(slideSelector));
      const dots = Array.from(root.querySelectorAll<HTMLElement>(dotSelector));
      const position = root.querySelector<HTMLElement>('[data-carousel-position]');
