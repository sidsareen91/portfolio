        return;
      }

      prototypePanelsRoot?.setAttribute('aria-busy', 'true');
      prototypePanelsRoot?.classList.add('is-tab-transitioning');
      const compactLayout = window.matchMedia('(max-width: 767px)').matches;
      const startHeight = prototypePanelsRoot?.getBoundingClientRect().height ?? 0;
      if (compactLayout && prototypePanelsRoot) {
        prototypePanelsRoot.style.height = `${startHeight}px`;
      }
      const exitAnimation = previousPanel.animate([
        {opacity: 1, transform: 'translateY(0)', filter: 'blur(0)'},
        {opacity: 0, transform: 'translateY(4px)', filter: 'blur(1.5px)'},
      ], {
        duration: 80,
        easing: 'cubic-bezier(0.4, 0, 1, 1)',
        fill: 'both',
      });
      prototypePanelTransitionAnimations = [exitAnimation];

      exitAnimation.finished.then(() => {
        if (transitionId !== prototypePanelTransitionId) return;
        exitAnimation.cancel();
        prototypeInfoPanels.forEach((panel) => {
          panel.hidden = Number(panel.dataset.labPanelIndex) !== nextIndex;
        });

        const enterAnimation = nextPanel.animate([
          {opacity: 0, transform: 'translateY(-8px)', filter: 'blur(2px)'},
          {opacity: 1, transform: 'translateY(0)', filter: 'blur(0)'},
