          position.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
        }
        keepActiveControlVisible();
        syncMediaPlayback();
      };

      const autoplay = createIdleAutoplayController({
        enabled: autoSwitchEnabled,
        itemCount: slides.length,
        intervalMilliseconds: switchIntervalMilliseconds,
        getActiveVideo: () => getNativeVideo(slides[currentIndex]),
        advance: () => show(currentIndex + 1),
        syncPlayback: syncMediaPlayback,
      });
      root.addEventListener('carouselvideoplay', autoplay.stop);
      root.addEventListener('carouselvideoend', autoplay.start);

      if (slides.length > 1) {
        dots.forEach((dot, index) => dot.addEventListener('click', () => {
          show(index);
          autoplay.reset();
        }));
        root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => {
          show(currentIndex - 1);
          autoplay.reset();
        });
        root.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
          show(currentIndex + 1);
          autoplay.reset();
        });
        root.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
            event.preventDefault();
            show(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
            autoplay.reset();
          }
        });
        const swipeSurface = root.querySelector<HTMLElement>('.hero-stage, .project-stage') ?? root;
        setupHorizontalSwipe(swipeSurface, (direction) => {
          show(currentIndex + direction);
          autoplay.reset();
        });
        bindIdleActivity(root, autoplay);
      }

      show(0);
      return autoplay;
    };

    const mediaCarousels = [
      setupMediaCarousel(
        document.querySelector<HTMLElement>('[data-hero-gallery]'),
        '[data-hero-slide]',
        '[data-hero-dot]',
      ),
      setupMediaCarousel(
        document.querySelector<HTMLElement>('[data-project-gallery]'),
        '[data-project-slide]',
        '[data-project-dot]',
      ),
    ].filter((carousel): carousel is CarouselController => carousel !== null);

    const setupShippedWorkCarousel = () => {
      const root = document.querySelector<HTMLElement>('[data-shipped-carousel]');
      const track = root?.querySelector<HTMLElement>('[data-shipped-track]');
      if (!root || !track) return;

      const cards = Array.from(track.querySelectorAll<HTMLElement>('.work-card'));
      const previousButton = root.querySelector<HTMLButtonElement>('[data-shipped-prev]');
      const nextButton = root.querySelector<HTMLButtonElement>('[data-shipped-next]');
      const status = root.parentElement?.querySelector<HTMLElement>('[data-shipped-status]');
      const desktopViewport = window.matchMedia('(min-width: 1024px)');
      const visibleCards = 4;
      const maximumIndex = Math.max(0, cards.length - visibleCards);
      let currentIndex = 0;
      let cardOffsets: number[] = [];
      let scrollIdleTimer: number | undefined;
      let scrollAnimationFrame: number | undefined;
      let resizeFrame: number | undefined;

      if (maximumIndex === 0) return;

      const refreshCardOffsets = () => {
        const firstOffset = cards[0]?.offsetLeft ?? 0;
        cardOffsets = cards.map((card) => card.offsetLeft - firstOffset);
      };

      const cardOffset = (index: number) => cardOffsets[index] ?? 0;

      const syncControls = (nextIndex: number) => {
        currentIndex = Math.max(0, Math.min(nextIndex, maximumIndex));
        if (previousButton) previousButton.disabled = currentIndex === 0;
        if (nextButton) nextButton.disabled = currentIndex === maximumIndex;
        if (status) {
          status.textContent = `Showing projects ${currentIndex + 1} to ${Math.min(currentIndex + visibleCards, cards.length)} of ${cards.length}`;
        }
      };

      const stopScrollAnimation = () => {
        if (scrollAnimationFrame !== undefined) {
          window.cancelAnimationFrame(scrollAnimationFrame);
