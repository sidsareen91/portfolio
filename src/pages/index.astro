          }

          const list = document.createElement('ul');
          list.dataset.labTabItems = '';
          block.items.forEach((item) => {
            const listItem = document.createElement('li');
            appendSpans(listItem, item.spans);
            list.append(listItem);
          });
          fragment.append(list);
        });
        return fragment;
