      const switchIntervalMilliseconds = Number(root.dataset.switchSeconds) * 1000;

      let currentIndex = 0;

      const keepActiveControlVisible = () => {
        const activeDot = dots[currentIndex];
        const progress = activeDot?.parentElement;
        if (!activeDot || !progress || progress.scrollWidth <= progress.clientWidth) return;
        const left = activeDot.offsetLeft - (progress.clientWidth - activeDot.offsetWidth) / 2;
        progress.scrollTo({
          left: Math.max(0, left),
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      };

      const syncMediaPlayback = () => {
        slides.forEach((slide, index) => {
          if (index !== currentIndex) resetNativeVideo(slide);
        });
      };

      const show = (nextIndex: number) => {
        currentIndex = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          const active = index === currentIndex;
          const decorative = slide.dataset.decorative === 'true';
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', String(decorative || !active));
          slide.querySelector<HTMLButtonElement>('.carousel-play')?.setAttribute('tabindex', active ? '0' : '-1');
          if (!active) resetVideoSlide(slide);
