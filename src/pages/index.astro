    const getPrototypeInfoTabs = () => Array.from(
      prototypeTabList?.querySelectorAll<HTMLButtonElement>('[data-lab-tab-index]') ?? [],
    );
    const getPrototypeInfoPanels = () => Array.from(
      prototypePanelsRoot?.querySelectorAll<HTMLElement>('[data-lab-panel-index]') ?? [],
    );

    const stopPrototypePanelTransition = () => {
      prototypePanelTransitionAnimations.forEach((animation) => animation.cancel());
