      });
      activePrototypeTabIndex = nextIndex;

      if (
        !nextPanel
        || nextPanel === previousPanel
        || reducedMotion.matches
        || !previousPanel
        || typeof previousPanel.animate !== 'function'
      ) {
        prototypeInfoPanels.forEach((panel) => {
