    const showPrototypeInfo = (requestedIndex: number, focus = false) => {
      const prototype = prototypeData[prototypeIndex];
      if (!prototype) return;
      const nextIndex = getValidPrototypeTabIndex(prototype, requestedIndex);
      const prototypeInfoTabs = getPrototypeInfoTabs();
      const prototypeInfoPanels = getPrototypeInfoPanels();
      const previousPanel = prototypeInfoPanels.find((panel) => !panel.hidden);
      const nextPanel = prototypeInfoPanels.find(
        (panel) => Number(panel.dataset.labPanelIndex) === nextIndex,
      );
      const transitionId = ++prototypePanelTransitionId;

      stopPrototypePanelTransition();

      prototypeInfoTabs.forEach((tab) => {
        const active = Number(tab.dataset.labTabIndex) === nextIndex;
